# Public client env for the extension build (anon key is safe in the bundle).
# Copy to .env or .env.local — do not commit real values.
WXT_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
WXT_SUPABASE_ANON_KEY=your-anon-key

# Optional. Local default remains http://localhost:3000 when unset.
# After Workers deploy, set this so DEFAULT_SERVER_URL and host_permissions match:
#   https://atelier-api.<account>.workers.dev
# WXT_API_URL=https://atelier-api.YOUR_SUBDOMAIN.workers.dev
