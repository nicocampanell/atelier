{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-verify-projects/types/**/*.ts",
    ".next-verify-projects/dev/types/**/*.ts",
    ".next-verify-backend/types/**/*.ts",
    ".next-verify-backend/dev/types/**/*.ts",
    ".next-verify-ext/types/**/*.ts",
    ".next-verify-ext/dev/types/**/*.ts",
    ".next-demo/types/**/*.ts",
    ".next-demo/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "extension",
    "scripts/verify-backend.ts",
    "scripts/verify-projects.ts",
    "scripts/verify-extension.ts",
    "scripts/verify-jev.ts",
    "scripts/verify-tags.ts"
  ]
}
