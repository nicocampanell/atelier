# Copy to .env.local and fill in. Never commit .env.local.

# Personal access token. Any long random string. The web app and the browser
# extension both send it as "Authorization: Bearer <token>".
ATELIER_TOKEN=change-me-to-a-long-random-string

# Optional: where local data lives (database and uploaded files).
ATELIER_DATA_DIR=./.data

# Optional: set to use hosted Postgres instead of the embedded one.
# DATABASE_URL=postgres://user:pass@host/db

# Optional: key for the embedding provider used for search by meaning.
# Without it, search falls back to keyword-only.
EMBEDDING_API_KEY=
