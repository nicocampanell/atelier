# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Auth validates the JWT; only ATELIER_OWNER_EMAIL may use the API).
# Data layer uses the service role client and always filters by user_id.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ATELIER_OWNER_EMAIL=you@example.com

# Optional: TypeSafe Jev key for relevance scoring. Searches send the query and
# up to 24 saved text snippets and supported uploaded images to TypeSafe.
# Without a key, search uses keywords only. Image scoring is experimental.
TYPESAFE_API_KEY=
# Optional model override; defaults to jev-latest.
# TYPESAFE_MODEL=jev-latest

# Bearer secret for POST /api/cron/requeue (Cloudflare Cron Trigger in Task 6).
CRON_SECRET=

# Comma-separated Origins allowed CORS access to /api/* (canvas Pages URL, etc.).
# ATELIER_ALLOWED_ORIGINS=http://localhost:5173
