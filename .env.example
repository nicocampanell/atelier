# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Auth validates the JWT; only ATELIER_OWNER_EMAIL may use the API).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ATELIER_OWNER_EMAIL=you@example.com
# Optional local fallback only during transition — remove once PGlite path is deleted:
# ATELIER_TOKEN=

# Optional: where local data lives (database and uploaded files).
ATELIER_DATA_DIR=./.data

# Optional: set to use hosted Postgres instead of the embedded one.
# DATABASE_URL=postgres://user:pass@host/db

# Optional: TypeSafe Jev key for relevance scoring. Searches send the query and
# up to 24 saved text snippets and supported local images to TypeSafe.
# Without a key, search uses keywords only. Image scoring is experimental.
TYPESAFE_API_KEY=
# Optional model override; defaults to jev-latest.
# TYPESAFE_MODEL=jev-latest
