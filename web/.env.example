# Public client env (anon key is safe in the browser). Do not put service-role secrets here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Production / Pages: absolute Workers API origin (no trailing slash required).
# Leave unset in local `npm run dev` so the Vite `/api` proxy is used.
VITE_API_URL=https://atelier-api.YOUR_SUBDOMAIN.workers.dev
